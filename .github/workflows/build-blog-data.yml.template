# DRAFT — .template, not live (deliberately not a real .yml so GitHub Actions
# won't try to run it). Mirrors torpdata/.github/workflows/build-blog-data.yml
# exactly (same steps, same auth, same R2 convention - read directly before
# writing this, not guessed at), adapted for a Python pipeline instead of R.
#
# TWO REAL BLOCKERS before this can go live, both Pete's call, not mine:
#   1. dropshotverse has no GitHub remote yet - this workflow needs a repo to
#      live in and run under.
#   2. CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID need to be added as repo
#      secrets (same names torpdata uses) - these are Cloudflare account
#      credentials, Pete needs to create/scope the R2 token himself.
#
# Once both exist: rename this file to build-blog-data.yml (drop .template),
# and this should work as-is - build_blog_data.py already writes to blog/ in
# the exact shape this workflow expects.

name: Build blog data

on:
  repository_dispatch:
    types: [blog-trigger]
  workflow_dispatch:

concurrency:
  group: blog-data
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Install dependencies
        run: pip install pandas numpy xgboost pyarrow

      - name: Build blog data
        working-directory: dropshotdata/scripts
        run: python build_blog_data.py

      - name: Validate outputs
        run: |
          echo "Files produced:"
          ls -la dropshotdata/blog/*.parquet 2>/dev/null || true
          for f in ratings.parquet predictions.parquet; do
            if [ ! -f "dropshotdata/blog/$f" ]; then
              echo "::error::Required output dropshotdata/blog/$f was not produced"
              exit 1
            fi
          done

      - uses: actions/setup-node@v7
        with:
          node-version: '20'

      - name: Install wrangler
        run: npm install -g wrangler

      - name: Upload to R2
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_R2_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          if [ -z "$CLOUDFLARE_API_TOKEN" ] || [ -z "$CLOUDFLARE_ACCOUNT_ID" ]; then
            echo "::error::Cloudflare credentials not configured"
            exit 1
          fi
          shopt -s nullglob
          files=(dropshotdata/blog/*.parquet)
          if [ ${#files[@]} -eq 0 ]; then
            echo "::error::No parquet files found in dropshotdata/blog/ - build may have failed"
            exit 1
          fi
          retry_upload() {
            local file="$1" key="$2" max_attempts=3 attempt=1
            while [ $attempt -le $max_attempts ]; do
              if wrangler r2 object put "$key" --file "$file" --cache-control "public, max-age=300" --remote; then
                return 0
              fi
              echo "::warning::Upload attempt $attempt/$max_attempts failed for $key, retrying in $(( 2 ** attempt ))s"
              sleep $(( 2 ** attempt ))
              attempt=$(( attempt + 1 ))
            done
            return 1
          }
          for f in "${files[@]}"; do
            key="inthegame-data/tennis/$(basename $f)"
            echo "Uploading $key..."
            if ! retry_upload "$f" "$key"; then
              echo "::error::Failed to upload $key after 3 attempts"
              exit 1
            fi
          done
          echo "Uploaded ${#files[@]} files to R2 (tennis/ prefix)"
